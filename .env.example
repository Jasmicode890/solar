# Required for secure Flask sessions
SECRET_KEY=

# Create the initial administrator on app startup
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Set to true only for local debugging
FLASK_DEBUG=false

# Set to true when serving over HTTPS
SESSION_COOKIE_SECURE=false

# Optional email notifications (Gmail app password)
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_RECIPIENT=

# Optional Meta WhatsApp Cloud API notifications
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_NAME=solar_prediction_alert
WHATSAPP_LANGUAGE_CODE=en_US
